# TraceFox deployment configuration
# Copy to .env and edit as needed:  cp .env.example .env

# Host label attached to all metrics (leave empty for auto-detect via reverse DNS)
TRACEFOX_HOST_LABEL=sunrise

# UDP port the forwarder listens on (agent must target this port)
TRACEFOX_UDP_PORT=9000

# Enable verbose logging in the forwarder (0 or 1)
TRACEFOX_VERBOSE=0

# Grafana admin password — CHANGE THIS before deploying!
GRAFANA_PASSWORD=tracefox
